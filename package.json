{
  "name": "@local/prompt-image-budget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Keeps each model request within a fixed image count by converting the oldest images to text placeholders",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
